[Unit]
Description=Google Sheet AI Celery worker
Wants=network-online.target redis-server.service
After=network-online.target redis-server.service

[Service]
Type=simple
User=saptadi73
Group=www-data
WorkingDirectory=/var/www/fastapi_app/fastapi-google-ai
ExecStart=/var/www/fastapi_app/fastapi-google-ai/venv/bin/python -m celery -A app.workers.celery_app:celery_app worker --loglevel=INFO --concurrency=1
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0027

[Install]
WantedBy=multi-user.target
