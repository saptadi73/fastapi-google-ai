upstream google_sheet_ai_api {
    server 127.0.0.1:8005;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name api-google.kanjabung.web.id;

    # Sesuaikan dengan lokasi sertifikat pada server.
    ssl_certificate /etc/letsencrypt/live/api-google.kanjabung.web.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-google.kanjabung.web.id/privkey.pem;

    client_max_body_size 10m;

    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "https://google.kanjabung.web.id" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Last-Event-ID" always;
            add_header Access-Control-Max-Age "86400" always;
            add_header Vary "Origin" always;
            add_header Content-Length "0";
            add_header Content-Type "text/plain; charset=utf-8";
            return 204;
        }

        add_header Access-Control-Allow-Origin "https://google.kanjabung.web.id" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Expose-Headers "X-Request-ID, Content-Disposition" always;
        add_header Vary "Origin" always;

        proxy_pass http://google_sheet_ai_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }
}

server {
    listen 80;
    server_name api-google.kanjabung.web.id;
    return 301 https://$host$request_uri;
}
