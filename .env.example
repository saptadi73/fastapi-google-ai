APP_NAME=google-sheet-ai-platform
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
HEALTH_CHECK_TIMEOUT_SECONDS=3
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://openpg:replace-me@127.0.0.1:5432/googleai
DATABASE_DDL_URL=
# Required for AI queries: a separate PostgreSQL LOGIN with SELECT only on semantic views.
DATABASE_NL2SQL_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=google-sheet-ai-platform
JWT_AUDIENCE=google-sheet-dashboard
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
BOOTSTRAP_TENANT=default
BOOTSTRAP_USERNAME=admin_etl@kanjabung.com
BOOTSTRAP_FULL_NAME=ETL Administrator
BOOTSTRAP_PASSWORD=replace-with-a-strong-password
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_CREDENTIAL_REF=default
GOOGLE_API_TIMEOUT_SECONDS=30
GOOGLE_MAX_ROWS=50000
GOOGLE_MAX_COLUMNS=100
OPENAI_API_KEY=
OPENAI_MODEL_ETL_CONFIG=
OPENAI_MODEL_NL2SQL=
OPENAI_STORE_RESPONSES=false
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=12000
# Set approved model prices to enable monetary cost accounting/budget enforcement.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
AI_DAILY_TENANT_BUDGET_USD=0
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
REDIS_REQUIRED=false
QUERY_CACHE_TTL_SECONDS=300
SIMILARITY_CACHE_TTL_SECONDS=900
NL2SQL_STATEMENT_TIMEOUT_MS=10000
NL2SQL_MAX_ROWS=1000
NL2SQL_MAX_ESTIMATED_COST=100000
NL2SQL_DAILY_USER_LIMIT=25
ETL_SAMPLE_ROW_LIMIT=200
JOB_POLL_SECONDS=5
JOB_STALE_MINUTES=30
ARTIFACT_STORAGE_PATH=storage/configs
REQUIRE_SEPARATE_APPROVER=true
# scripts/prepare_test_db.py creates googleai_test and fills this value in .env.
TEST_DATABASE_URL=
