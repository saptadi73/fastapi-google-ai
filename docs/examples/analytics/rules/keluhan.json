      "output_unit": "RATIO",
      "description": "Ambang dan formula contoh; verifikasi unit, metode, grain dan target dengan pemilik bisnis."
    }
  ],
  "rules": [
    {
      "rule_code": "review_sla_breach_ratio",
      "formula_code": "sla_breach_ratio",
      "operator": "gt",
      "threshold": "0.10",
      "threshold_upper": null,
      "action_description": "Verifikasi antrean dan shift; usulkan perbaikan SLA setelah bukti diperiksa.",
